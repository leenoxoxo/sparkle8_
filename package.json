{
  "name": "sparkle-boutique",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env server/index.js",
    "db:prepare": "node --env-file=.env server/prepare-db.js",
    "admin:setup": "node --env-file=.env server/create-admin.js",
    "catalog:import": "node --env-file-if-exists=.env server/import-catalog.js",
    "start": "node server/index.js",
    "test": "node --test",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cloudinary": "^2.11.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "lucide-react": "latest",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0"
  }
}
